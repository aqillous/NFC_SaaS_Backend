APP_NAME=NFC Review SaaS
ENVIRONMENT=development
DEBUG=true

#
# --- Local Postgres (default) ---
# DATABASE_URL=postgresql+psycopg2://nfc_user:nfc_password@localhost:5432/nfc_reviews
# DB_SSL_REQUIRE=false

DATABASE_URL=postgresql+psycopg2://nfc_user:nfc_password@localhost:5432/nfc_reviews
DB_SSL_REQUIRE=false

# Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Base URL used to build NFC card URLs (e.g. https://mydomain.com)
PUBLIC_BASE_URL=http://localhost:8000

REDIRECT_RATE_LIMIT=30/minute
