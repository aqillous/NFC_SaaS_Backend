APP_NAME=NFC Review SaaS
ENVIRONMENT=development
DEBUG=true

# PostgreSQL connection string.
#
# --- Local Postgres (default) ---
# DATABASE_URL=postgresql+psycopg2://nfc_user:nfc_password@localhost:5432/nfc_reviews
# DB_SSL_REQUIRE=false
#
# --- Supabase ---
# Get this from Supabase dashboard -> Project Settings -> Database -> Connection string
# (choose "URI", then change the scheme from postgresql:// to postgresql+psycopg2://).
# URL-encode any special characters in your password (@, #, / etc).
#
# Option A - Session pooler (port 5432, IPv4-compatible, recommended default
# for a normal long-running backend server like this one):
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Option B - Direct connection (IPv6 only — works if your host supports IPv6):
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR-PASSWORD@db.xxxxxxxxxxxx.supabase.co:5432/postgres
#
# Option C - Transaction pooler (port 6543, best for serverless/many short-lived
# connections; NOT recommended for this app's use case, but supported):
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
DATABASE_URL=postgresql+psycopg2://nfc_user:nfc_password@localhost:5432/nfc_reviews
DB_SSL_REQUIRE=false

# Generate a strong random value in production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Base URL used to build NFC card URLs (e.g. https://mydomain.com)
PUBLIC_BASE_URL=http://localhost:8000

REDIRECT_RATE_LIMIT=30/minute
